# DeutschFlow PWA - Deployment Environment Variables
#
# Access Gate: Unlock password for the web application. Use 16+ random characters or a
# long passphrase: the login throttle still allows ~2,880 guesses a day, and the server
# logs a warning at startup if it is shorter.
SITE_PASSWORD=your-secure-access-password

# Session Signing: High-entropy secret for signing session HMAC tokens (32+ characters)
# Tip: Generate with `openssl rand -base64 32` or any random 32+ char string
SESSION_SECRET=replace-with-at-least-32-random-characters-secret

# AI model (optional): overrides the Groq model the browser calls. Must be one of
# SUPPORTED_GROQ_MODELS in src/lib/ai/groq.ts, or it is ignored. NEXT_PUBLIC_ because
# the Groq request is made from the browser; it is inlined at build time, so rebuild
# after changing it.
# NEXT_PUBLIC_GROQ_MODEL=openai/gpt-oss-20b

# Self-hosting only (ignored on Vercel): the header your reverse proxy sets with the
# client's address, e.g. X-Forwarded-For or X-Real-IP. Unset, every caller shares one
# login-throttle bucket. Set it ONLY if the proxy is the sole way in and it overwrites
# or appends this header - otherwise clients can choose their own throttle identity.
# TRUSTED_PROXY_HEADER=X-Forwarded-For
