<?xml version="1.0" encoding="utf-8"?>
<!--
    The settings DataStore holds the user's Gemini API key in plaintext. It must
    not leave the device in a backup or a device-to-device transfer; everything
    else (the vocabulary database, the widget state) is fine to carry over.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
