<?xml version="1.0" encoding="utf-8"?>
<!--
    The settings DataStore holds the user's Groq API key. It is encrypted under a
    key that lives in the Android Keystore and never leaves the device, so a copy
    restored elsewhere would be undecryptable rather than dangerous - but it would
    also be useless, and a store full of ciphertext nothing can read is worse than
    no store at all. Excluded from both channels for that reason; everything else
    (the vocabulary database, the widget state) is fine to carry over.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
