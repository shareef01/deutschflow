<?xml version="1.0" encoding="utf-8"?>
<!--
    Monochrome version of the mark for Android 13+ themed icons.

    The system reduces this to its alpha channel and tints it, so it must be one
    flat silhouette with no gradient and no interior detail. The glyph only - the
    glass disc is omitted, the way a themed icon wants the mark itself. Same
    geometry as the glyph in ic_launcher_foreground: the filled U (even-odd path,
    counter as a real hole) and the two dots, in solid white.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M36,43 L36,62 A18,18 0 0 1 72,62 L72,43 Z M45,43 L45,62 A9,9 0 0 1 63,62 L63,43 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M35,32a5.5,5.5 0 1,0 11,0a5.5,5.5 0 1,0 -11,0z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M62,32a5.5,5.5 0 1,0 11,0a5.5,5.5 0 1,0 -11,0z" />
</vector>
