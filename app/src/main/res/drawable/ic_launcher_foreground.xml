<?xml version="1.0" encoding="utf-8"?>
<!--
    Launcher icon foreground: a circular glass disc carrying the app's mark, an Ü.

    The disc is the app's own surface language - white glass fill at 4% over the
    void, an azure hairline edge - bent into a circle because the Pixel launcher
    renders this icon through a circular mask: a circle inside a circle is the
    only shape that can fill the mask without either losing corners or wasting
    the space inside it. Disc radius 48dp against the 54dp mask leaves a 6dp ring
    of void around the glass, which is exactly how the app's surfaces sit on
    their black ground.

    The glyph is a filled letterform, not a stroke: two 9dp stems with a flat
    top, a uniform 9dp bowl (outer arc r18, inner counter r9, same centre), and
    the two umlaut dots on the stems' centre lines. Filled geometry is what makes
    it read as a U at launcher size, where a stroked path with round caps reads
    as an arch. The fill carries the AzureGlow -> AzureDeep ramp, the exact
    gradient the theme uses for every glow in the app.

    Fitting: glyph spans x 36..72, y 26.5..80, centre (54, 53.25) - the canvas
    centre - and every point of it sits inside the 33dp safe circle that survives
    the 1.15x parallax crop; the disc's outer edge (r 49.25 with its stroke) sits
    inside the 54dp circular mask with room to spare.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- The glass disc: white 4% fill, azure hairline edge. -->
    <path
        android:fillColor="#0AFFFFFF"
        android:strokeColor="#5900E5FF"
        android:strokeWidth="2.5"
        android:pathData="M54,6a48,48 0 1,0 0.01,0z" />
    <!--
        The U as one even-odd path: the outer contour runs left stem, bowl, right
        stem and closes across the flat top; the inner counter is the hole.
    -->
    <path
        android:fillType="evenOdd"
        android:pathData="M36,43 L36,62 A18,18 0 0 1 72,62 L72,43 Z M45,43 L45,62 A9,9 0 0 1 63,62 L63,43 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="27"
                android:endX="54"
                android:endY="80">
                <item
                    android:color="#00E5FF"
                    android:offset="0.0" />
                <item
                    android:color="#2FB4FF"
                    android:offset="0.5" />
                <item
                    android:color="#0A84FF"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- The umlaut: two dots on the stems, in the live end of the ramp. -->
    <path
        android:fillColor="#00E5FF"
        android:pathData="M35,32a5.5,5.5 0 1,0 11,0a5.5,5.5 0 1,0 -11,0z" />
    <path
        android:fillColor="#00E5FF"
        android:pathData="M62,32a5.5,5.5 0 1,0 11,0a5.5,5.5 0 1,0 -11,0z" />
</vector>
