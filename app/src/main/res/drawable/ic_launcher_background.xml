<?xml version="1.0" encoding="utf-8"?>
<!--
    Launcher icon background: the void, with one azure light pool at the centre.

    Same vocabulary as the app itself: true black ground, and the only thing
    arriving out of it is the azure the theme's gradients are made of. The pool is
    centred behind the glass tile the foreground draws, so the tile reads as glass
    catching the light rather than as a panel pasted onto black.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#000000"
        android:pathData="M0,0h108v108h-108z" />
    <path android:pathData="M54,0a54,54 0 1,0 0.01,0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="62">
                <item
                    android:color="#16324E"
                    android:offset="0.0" />
                <item
                    android:color="#050A12"
                    android:offset="0.55" />
                <item
                    android:color="#000000"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
